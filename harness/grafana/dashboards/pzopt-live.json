     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pzopt-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT coalesce((SELECT avg(total_w) FROM live_sysmon WHERE t > now() - interval '5 seconds'), (SELECT avg(total_w) FROM live_power WHERE t > now() - interval '5 seconds')) AS \"total W\",\n  coalesce((SELECT avg(cpu_w) FROM live_sysmon WHERE t > now() - interval '5 seconds'), (SELECT avg(cpu_w) FROM live_power WHERE t > now() - interval '5 seconds')) AS \"CPU W\",\n  coalesce((SELECT avg(gpu_w) FROM live_sysmon WHERE t > now() - interval '5 seconds'), (SELECT avg(gpu_w) FROM live_power WHERE t > now() - interval '5 seconds')) AS \"GPU W\",\n  (SELECT avg(total_w) / nullif(avg(fps), 0) FROM live_power WHERE t > now() - interval '5 seconds') AS \"J/frame\"",
     "hide": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
