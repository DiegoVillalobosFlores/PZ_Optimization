  {
   "type": "stat",
   "title": "Power, last 5 s",
   "description": "sysmon while a harness run is going, else the game's own sampler (pzopt-power.out, written while the overlay's frame log is on)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pzopt-pg"
   },
   "targets": [
