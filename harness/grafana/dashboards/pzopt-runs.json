     "editorMode": "code",
     "format": "time_series",
     "rawSql": "SELECT started AS time, label AS metric, fps_mean AS value FROM runs WHERE $__timeFilter(started) AND machine IN (${machine:sqlstring}) AND coalesce(mode, '') IN (${mode:sqlstring}) AND label ~ ${label:sqlstring} AND fps_mean IS NOT NULL ORDER BY 1",
