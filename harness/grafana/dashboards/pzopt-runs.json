  {
   "type": "table",
   "title": "Below the cap with hardware left over",
   "description": "The objective: fps below the 240 cap with neither the GPU (\u2265 90 %) nor the game thread (\u2265 90 %) saturated is itself a finding.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pzopt-pg"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pzopt-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT started, run, fps_mean AS fps, p99_ms AS p99, gpu_pct AS \"GPU %\", busiest_core_pct AS \"busiest core %\",\n  game_thread_pct AS \"game thread %\", headroom_finding AS \"Jev headroom\"\nFROM runs WHERE $__timeFilter(started) AND machine IN (${machine:sqlstring}) AND coalesce(mode, '') IN (${mode:sqlstring}) AND label ~ ${label:sqlstring} AND CASE\n  WHEN gpu_pct >= 90 THEN 'GPU-bound'\n  WHEN game_thread_pct >= 90 OR game_load_pct >= 90 THEN 'game thread'\n  WHEN fps_mean >= 235 AND props NOT LIKE '%uncappedFps=true%' THEN 'at 240 cap'\n  WHEN fps_mean IS NULL THEN NULL\n  ELSE 'headroom left' END = 'headroom left' ORDER BY started DESC",
