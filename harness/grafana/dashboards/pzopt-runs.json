  {
   "type": "table",
   "title": "Runs",
   "description": "Frame times in ms over the route window (pzopt-frames.out); CPU / GPU from sysmon, game thread from pzopt-threads.out. Click a run for its dashboard, 'previous' to compare with the last run of the same label.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pzopt-pg"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pzopt-pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT started, run, fps_mean AS fps, fps_1pct_low AS \"1% low\", p50_ms AS p50, p99_ms AS p99, p99_9_ms AS \"p99.9\", max_ms AS max,\n  over_33ms AS \">33ms\", jitter_ms AS jitter, cpu_pct AS \"CPU %\", busiest_core_pct AS \"busiest core %\", gpu_pct AS \"GPU %\",\n  game_thread_pct AS \"game thread %\", CASE\n  WHEN gpu_pct >= 90 THEN 'GPU-bound'\n  WHEN game_thread_pct >= 90 OR game_load_pct >= 90 THEN 'game thread'\n  WHEN fps_mean >= 235 AND props NOT LIKE '%uncappedFps=true%' THEN 'at 240 cap'\n  WHEN fps_mean IS NULL THEN NULL\n  ELSE 'headroom left' END AS bound, verdict, round(verdict_confidence::numeric, 2) AS conf, valid,\n  variant, machine, mode, preset, chunk_p99_ms AS \"chunk p99\", gc_events AS gc, zoom, resolution, label,\n  lag(run) OVER (PARTITION BY label ORDER BY started) AS previous\nFROM runs WHERE $__timeFilter(started) AND machine IN (${machine:sqlstring}) AND coalesce(mode, '') IN (${mode:sqlstring}) AND label ~ ${label:sqlstring} ORDER BY started DESC",
     "hide": false
    }
   ],
   "fieldConfig": {
    "defaults": {
